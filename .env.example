POSTGRES_USER=connectify
POSTGRES_PASSWORD=connectify
POSTGRES_DB=connectify
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

DATABASE_URL="postgresql://connectify:connectify@localhost:5432/connectify?schema=public"
REDIS_URL="redis://localhost:6379"

# Secret used to sign/verify JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
